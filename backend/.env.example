# 复制为 backend/.env 并填写。不填 LLM_API_KEY 时后端以 MOCK 模式运行（返回固定文本，用于联调）。

# OpenAI 兼容接口，三个变量即可切换供应商
# DeepSeek: https://api.deepseek.com  模型 deepseek-chat
# Qwen:     https://dashscope.aliyuncs.com/compatible-mode/v1  模型 qwen-plus
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 故事稿生成用的模型（值得用最强的，量小成本可控）；留空则复用 LLM_MODEL
STORY_MODEL=

# SQLite 数据库文件位置（相对 backend 目录）
DATABASE_URL=sqlite:///data/app.db
